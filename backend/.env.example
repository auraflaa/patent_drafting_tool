# Firebase project settings
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json
# Hosts that cannot mount a file (Vercel, Cloud Run) can inject the JSON here
# instead. Keep it in the platform's secret manager, never in Git.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Empty = the (default) database. Set a name to use a named Firestore database.
FIRESTORE_DATABASE_ID=
# Optional: only when using the Firebase Emulator Suite
FIREBASE_EMULATOR_HOST=

# The first login from this email gets SUPER_ADMIN privileges.
# Use an email you control. Never use a public/shared email.
BOOTSTRAP_ADMIN_EMAIL=you@example.com

# Application
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1
# Proxy hops allowed to set X-Forwarded-For. Uvicorn trusts only 127.0.0.1 by
# default; behind Cloud Run/nginx set this to the proxy address (or "*" when the
# app is not directly reachable), otherwise every user shares one rate bucket.
FORWARDED_ALLOW_IPS=127.0.0.1
# Per-client cap on mutating /api/auth routes. 0 disables it.
# /api/auth/me and /api/auth/logout are exempt (they run on every page load).
AUTH_RATE_LIMIT_PER_MINUTE=60
# self_hosted (default) or vercel. "vercel" clamps uploads below the
# platform's 4.5 MB function body cap.
DEPLOYMENT_TARGET=self_hosted
# 0 = profile default: 10 MiB self-hosted, 4 MiB on Vercel.
# Explicit values are still clamped to the platform cap on Vercel.
MAX_UPLOAD_SIZE_BYTES=0
# Uploaded files are compressed into Firestore, which caps one document at
# 1 MiB; anything above ~900 KB compressed is rejected with a 413.
# Allowlist: an extension is accepted only when listed, then the bytes are
# checked against it (magic bytes / Office ZIP structure). PDFs are converted
# to DOCX before storage; no PDF is ever stored.
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.odt,.txt,.csv,.md,.rtf,.png,.jpg,.jpeg,.gif,.webp,.tif,.tiff

# Optional AI drafting. Without this, draft generation returns a clearly labelled placeholder.
# Any OpenAI-compatible endpoint works (Gemini, Groq/Qwen, local Llama, etc.).
# Set all three to enable; leave empty for the stub.
AI_API_URL=
AI_API_KEY=
AI_MODEL=
